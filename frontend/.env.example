# Base URL for the Inkloom API. The default sends requests through the Vite
# dev-server proxy (see vite.config.ts) so no credentials belong in the browser.
VITE_API_BASE_URL=/api/v1

# Development only: where the Vite proxy sends /api requests. The default is
# http://127.0.0.1:8000. Set this when the backend runs on another port.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Development only: Vite dev-server port. The default is 3000.
# PORT=3000

# There are deliberately no Supabase keys, LLM keys, or service-role credentials
# in the frontend. Every integration, upload limit, and authorization decision
# is enforced by the FastAPI server.
