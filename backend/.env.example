# Inkloom AI - Backend Environment Configuration
# Copy to .env and adjust. Every value below has a safe local default.

ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Must be a JSON array (the setting is parsed as a list). Add your deployed
# frontend origin here when the API is hosted, e.g. ["https://inkloom-ai.vercel.app"].
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Persistence
# SQLite is the zero-setup default. The demo seed runs automatically on an empty database.
# On an ephemeral host (for example the Render free plan) a SQLite file and the uploads
# folder reset on restart or redeploy, and the startup seed recreates the fictional demo
# workspace. Health reporting states this honestly instead of claiming persistence.
DATABASE_URL=sqlite:///./inkloom.db
# Optional Postgres connection (server-side only; never expose in the frontend).
# Pointing DATABASE_URL at Postgres makes records durable across restarts. The Postgres
# driver (psycopg) is already in requirements.txt. Tables are created automatically on
# first start; no data is dropped or overwritten when the URL changes.
# The bundled supabase/migrations are a starter subset, not full runtime parity; review
# the generated schema before using Postgres with real data.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Durability overrides. Leave unset to let the app infer (Postgres = durable,
# SQLite = ephemeral). Set these to true only after you have attached a real
# persistent volume, so health reporting stays accurate.
# DATABASE_PERSISTENT=true
# UPLOADS_PERSISTENT=true

# Server-owned upload storage. Relative paths resolve from the backend working directory.
# Uploaded files live on the server filesystem and are durable only when UPLOAD_DIR sits
# on a mounted volume or after moving to an object store. If a file is missing, the API
# reports that the stored file is no longer available rather than serving broken content.
# UPLOAD_DIR=./data/uploads

# Backup and recovery (align with whichever database you actually use)
# - SQLite: copy the database file while the service is stopped, then keep periodic copies;
#   restore by replacing the file. Data and UPLOAD_DIR must be backed up together.
# - Supabase/Postgres: use the provider's automated backups or point-in-time recovery and
#   restore into a new project/database; never drop or recreate the production database in
#   place. Uploaded files are not covered by database backups, so snapshot UPLOAD_DIR too.

# Upload limits
MAX_UPLOAD_BYTES=26214400
MAX_VIDEO_UPLOAD_BYTES=125829120
MAX_PDF_PAGES=120

# Demo identity and the fictional seeded workspace.
# DEMO_MODE=true makes the role switcher available and labels demo records.
DEMO_MODE=true
DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
DEFAULT_WORKSPACE_NAME=Acme Cloud Technologies

# ---------------------------------------------------------------------------
# Optional integration flags
#
# The deterministic rule engine is always the source of rule-based findings and
# works with everything below empty. The AI flags below enable an OPTIONAL
# assistant that drafts correction wording for a human reviewer; it never
# replaces the deterministic checks or the approval workflow, and it is never
# presented as verified proof. Keys stay server-side only.
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock          # mock | openai | gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
# Request controls. These bound cost/latency and keep the app usable if a
# provider times out, is rate-limited, or goes down.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=700
LLM_MAX_INPUT_CHARS=6000
AI_RATE_LIMIT_PER_MINUTE=12

# No OCR service is bundled. Image uploads and scanned PDFs are stored for
# human review; text-based PDFs are extracted with pypdf.
OCR_PROVIDER=none

# No speech-to-text service is enabled. Video checks require a transcript with
# timestamps supplied by the user.
TRANSCRIPTION_PROVIDER=none
# FFMPEG_PATH=
