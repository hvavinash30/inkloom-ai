# Inkloom AI - Backend Environment Configuration
# Copy to .env and adjust. Every value below has a safe local default.

ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Must be a JSON array (the setting is parsed as a list). Add your deployed
# frontend origin here when the API is hosted, e.g. ["https://inkloom-ai.vercel.app"].
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Persistence
# SQLite is the zero-setup default. The demo seed runs automatically on an empty database.
DATABASE_URL=sqlite:///./inkloom.db
# Optional Supabase Postgres connection (server-side only; never expose in the frontend).
# The bundled supabase/migrations are a starter subset, not full runtime parity; review
# the generated schema before using Postgres with real data.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server-owned upload storage. Relative paths resolve from the backend working directory.
# UPLOAD_DIR=./data/uploads

# Upload limits
MAX_UPLOAD_BYTES=26214400
MAX_VIDEO_UPLOAD_BYTES=125829120
MAX_PDF_PAGES=120

# Demo identity and the fictional seeded workspace.
# DEMO_MODE=true makes the role switcher available and labels demo records.
DEMO_MODE=true
DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
DEFAULT_WORKSPACE_NAME=Acme Cloud Technologies

# ---------------------------------------------------------------------------
# Optional integration flags
#
# This build does NOT call a language model in the audit, assistant, OCR, or
# transcription paths. These flags are only reported in the Settings panel so
# operators can see whether a provider is present. Every check below runs
# locally, and the app stays fully usable with all of these values empty.
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# No OCR service is bundled. Image uploads and scanned PDFs are stored for
# human review; text-based PDFs are extracted with pypdf.
OCR_PROVIDER=none

# No speech-to-text service is enabled. Video checks require a transcript with
# timestamps supplied by the user.
TRANSCRIPTION_PROVIDER=none
# FFMPEG_PATH=
